# ===== 推理服務（LLAMA） =====
# 後端串接的推理服務位址（與 app/config.py 的 llama_api_url 預設值一致）
LLAMA_API_URL=http://127.0.0.1:10000
# 可選：推理服務若啟用 API key 驗證才需要
# LLAMA_API_KEY=
# 單次生成最多 token
LLAMA_MAX_TOKENS=512
# 串流請求的逾時（秒）
LLAMA_REQUEST_TIMEOUT=60.0

# ===== Guardrail =====
# Mac / 無 CUDA 環境保持 cpu 即可（僅在有 NVIDIA GPU 時才設 cuda）
GUARDRAIL_DEVICE=cpu
# Guardrail 推論使用的 CPU 執行緒數
GUARDRAIL_CPU_THREADS=4
# 模型不可用且規則未命中時是否拒答（true=fail-closed 以 PROMPT_ATTACK 拒答；預設 false=標記 UNCERTAIN 放行）
# GUARDRAIL_FAIL_CLOSED=false

# ===== Context 管理 =====
# CONTEXT_STRATEGY 可選 compress（以 LLM 摘要壓縮舊對話）或 window（直接丟棄最舊內容）
CONTEXT_STRATEGY=compress
LLAMA_CONTEXT_MAX_TOKENS=131072
LLAMA_CONTEXT_RESERVED_OUTPUT_TOKENS=4096
CONTEXT_COMPRESS_THRESHOLD_RATIO=0.8
CONTEXT_COMPRESS_KEEP_RECENT_MESSAGES=8
CONTEXT_WINDOW_KEEP_RECENT_MESSAGES=8
CONTEXT_SUMMARY_TARGET_CHARS=1200

# ===== 串流 =====
# 兩個 chunk 之間的最大等待秒數（逾時回「模型回應逾時」）
STREAM_CHUNK_TIMEOUT=120.0

# ===== WebSocket =====
MAX_MESSAGE_SIZE=10240
HISTORY_MAX_LENGTH=20
# 每連線速率限制：60 秒內最多 30 則使用者訊息
WS_RATE_LIMIT_MESSAGES=30
WS_RATE_LIMIT_WINDOW_SECONDS=60.0
# WS handshake Origin 白名單（注意：list 型別必須用 JSON 格式，逗號字串會讓服務起不來）
# 設為 ["*"] 可關閉檢查（不建議對外開放時使用）
WS_ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost:8080", "http://127.0.0.1:5173", "http://127.0.0.1:3000", "http://127.0.0.1:8080"]

# ===== 其他 HTTP 逾時（秒） =====
REQUEST_TIMEOUT=30.0
CONNECT_TIMEOUT=5.0

# ===== CORS =====
# 注意：list 型別必須用 JSON 格式（pydantic-settings v2 不支援逗號分隔字串）
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
