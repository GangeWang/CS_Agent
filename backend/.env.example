# ===== 推理服務（LLAMA） =====
# 後端串接的推理服務位址（與 app/config.py 的 llama_api_url 預設值一致）
LLAMA_API_URL=http://127.0.0.1:10000
# 可選：推理服務若啟用 API key 驗證才需要
# LLAMA_API_KEY=
# 單次生成最多 token
LLAMA_MAX_TOKENS=512
# 串流請求的逾時（秒）
LLAMA_REQUEST_TIMEOUT=60.0

# ===== Guardrail =====
# Mac / 無 CUDA 環境保持 cpu 即可（僅在有 NVIDIA GPU 時才設 cuda）
GUARDRAIL_DEVICE=cpu
# Guardrail 推論使用的 CPU 執行緒數
GUARDRAIL_CPU_THREADS=4

# ===== Context 管理 =====
# CONTEXT_STRATEGY 可選 compress（以 LLM 摘要壓縮舊對話）或 window（直接丟棄最舊內容）
CONTEXT_STRATEGY=compress
LLAMA_CONTEXT_MAX_TOKENS=131072
LLAMA_CONTEXT_RESERVED_OUTPUT_TOKENS=4096
CONTEXT_COMPRESS_THRESHOLD_RATIO=0.8
CONTEXT_COMPRESS_KEEP_RECENT_MESSAGES=8
CONTEXT_WINDOW_KEEP_RECENT_MESSAGES=8
CONTEXT_SUMMARY_TARGET_CHARS=1200

# ===== WebSocket =====
MAX_MESSAGE_SIZE=10240
HISTORY_MAX_LENGTH=20

# ===== 其他 HTTP 逾時（秒） =====
REQUEST_TIMEOUT=30.0
CONNECT_TIMEOUT=5.0

# ===== CORS（逗號分隔） =====
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
