# Ollama Configuration
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_URL=http://127.0.0.1:8008
OLLAMA_DEBUG=0

# WebSocket Configuration
MAX_MESSAGE_SIZE=10240
HISTORY_MAX_LENGTH=20

# Context management
# CONTEXT_STRATEGY can be compress (summarize old turns) or window (drop old turns).
LLAMA_CONTEXT_MAX_TOKENS=4096
LLAMA_CONTEXT_RESERVED_OUTPUT_TOKENS=1024
CONTEXT_STRATEGY=compress
CONTEXT_COMPRESS_THRESHOLD_RATIO=0.8
CONTEXT_COMPRESS_KEEP_RECENT_MESSAGES=8
CONTEXT_WINDOW_KEEP_RECENT_MESSAGES=8
CONTEXT_SUMMARY_TARGET_CHARS=1200

# Timeout Configuration (in seconds)
REQUEST_TIMEOUT=30.0
CONNECT_TIMEOUT=5.0

# CORS Configuration (comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
