# LLAMA / llama.cpp-compatible service configuration
LLAMA_API_URL=http://127.0.0.1:10000
LLAMA_API_KEY=
LLAMA_STREAM_TIMEOUT=600.0
LLAMA_REQUEST_TIMEOUT=60.0
LLAMA_MAX_TOKENS=512

# Backward-compatible Ollama-style settings
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_URL=http://127.0.0.1:8008
OLLAMA_DEBUG=0

# WebSocket Configuration
MAX_MESSAGE_SIZE=10240
HISTORY_MAX_LENGTH=20

# Timeout Configuration (in seconds)
REQUEST_TIMEOUT=30.0
CONNECT_TIMEOUT=5.0

# CORS Configuration (JSON list for pydantic-settings)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
